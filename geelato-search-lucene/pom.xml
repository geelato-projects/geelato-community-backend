<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>geelato-parent</artifactId>
    <groupId>cn.geelato</groupId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath/>
  </parent>

  <artifactId>geelato-search-lucene</artifactId>
  <packaging>jar</packaging>
  <name>geelato-search-lucene</name>
  <description>嵌入式 Lucene 检索引擎实现：NRT + ngram contains，异步事件索引同步 + 失败补偿 + 对账 + reindex</description>

  <properties>
    <lucene.version>9.11.1</lucene.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>cn.geelato</groupId>
      <artifactId>geelato-search-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>cn.geelato</groupId>
      <artifactId>geelato-core</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.geelato</groupId>
      <artifactId>geelato-orm</artifactId>
    </dependency>
    <!-- 管理端点注解 @ApiRuntimeRestController -->
    <dependency>
      <groupId>cn.geelato</groupId>
      <artifactId>geelato-web-common</artifactId>
    </dependency>

    <!-- 嵌入式 Lucene -->
    <dependency>
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-core</artifactId>
      <version>${lucene.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-analysis-common</artifactId>
      <version>${lucene.version}</version>
    </dependency>
    <!-- Span 查询（contains 语义）位于 queries 模块 org.apache.lucene.queries.spans -->
    <dependency>
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-queries</artifactId>
      <version>${lucene.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>

    <!-- TCK 契约测试 -->
    <dependency>
      <groupId>cn.geelato</groupId>
      <artifactId>geelato-search-api</artifactId>
      <version>${project.version}</version>
      <classifier>tests</classifier>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 装配测试：模拟双 DataSource（无 @Primary）的启动场景 -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
